<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="delivery_note_template">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: 'DejaVu Sans', Arial, sans-serif;">

                    <!-- Heading kept untouched -->
                    <div style="text-align:center; margin-bottom:20px;">
                        <h2>Delivery Note <br/><span style="font-weight: normal;">مذكرة تسليم</span></h2>
                    </div>
                    <br/>
                    <!-- Info Table: Reduced font size (11px), tighter spacing, and 1-line labels -->
                    <table style="width:100%; margin-bottom:12px; border-collapse:separate; border-spacing:0 4px; font-size:15px;">
                        <tr>
                            <!-- Left Side (57% total) -->
                            <td style="width:22%; white-space:nowrap;"><b>SN / الرقم التسلسلي:</b></td>
                            <td style="width:35%;"><b><span t-field="o.name"/></b></td>

                            <!-- Center Gap (2%) -->
                            <td style="width:1%;"></td>

                            <!-- Right Side (47% total) -->
                            <td style="width:22%; white-space:nowrap;"><b>Date / التاريخ:</b></td>
                            <td style="width:20%; text-align:right;"><b><span t-field="o.scheduled_date"/></b></td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap;"><b>City Code / رمز المدينة:</b></td>
                            <td><b><span t-field="o.city_code"/></b></td>

                            <td></td>

                            <td style="white-space:nowrap;"><b>Salesman / مندوب المبيعات:</b></td>
                            <td style="text-align:right;">
                                <b>
                                    <span t-if="o.sale_id" t-field="o.sale_id.user_id"/>
                                    <span t-else="" t-field="o.sales_person_id"/>
                                </b>
                            </td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap; vertical-align:top;"><b>Customer / العميل:</b></td>
                            <td style="vertical-align:top;"><b><span t-field="o.partner_id"/></b></td>

                            <td></td>

                            <td style="white-space:nowrap; vertical-align:top;"><b>Customer Phone / هاتف العميل:</b></td>
                            <td style="text-align:right; vertical-align:top;"><b><span t-field="o.customer_phone"/></b></td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap; vertical-align:top;"><b>Address / العنوان:</b></td>
                            <td style="vertical-align:top;"><b><span t-esc="', '.join(filter(None, [o.partner_id.street, o.partner_id.street2, o.partner_id.city, o.partner_id.state_id.name if o.partner_id.state_id else '', o.partner_id.zip, o.partner_id.country_id.name if o.partner_id.country_id else '']))"/></b></td>

                            <td></td>

                            <td style="white-space:nowrap; vertical-align:top;"><b>Leave Time / وقت المغادرة:</b></td>
                            <td style="text-align:right; vertical-align:top;"><b><span t-field="o.leave_datetime"/></b></td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap;"><b>Sales Order / أمر المبيعات:</b></td>
                            <td><b><span t-esc="o.origin"/></b></td>

                            <td></td>

                            <td style="white-space:nowrap;"><b>Truck Plate No / رقم اللوحة:</b></td>
                            <td style="text-align:right;"><b><span t-field="o.truck_plate_no"/></b></td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap;"><b>Driver Name / اسم السائق:</b></td>
                            <td><b><span t-field="o.driver_name"/></b></td>

                            <td></td>

                            <td style="white-space:nowrap;"><b>Driver Mobile / جوال السائق:</b></td>
                            <td style="text-align:right;"><b><span t-field="o.driver_mobile"/></b></td>
                        </tr>
                    </table>

                    <!-- Product Table: Reduced font size (11px) and padding (4px) -->
                    <table style="width:100%; border-collapse:collapse; margin-top:10px; font-size:15px;">
                        <thead>
                            <tr>
                                <th style="border:1px solid #000; padding:4px; text-align:center;"><b>#</b></th>
                                <th style="border:1px solid #000; padding:4px;"><b>Item Code <br/><span style="font-size:9px; font-weight:normal;">رمز الصنف</span></b></th>
                                <th style="border:1px solid #000; padding:4px;"><b>Description <br/><span style="font-size:9px; font-weight:normal;">الوصف</span></b></th>
                                <th style="border:1px solid #000; padding:4px; text-align:right;"><b>Qty (MTR) <br/><span style="font-size:9px; font-weight:normal;">الكمية (متر)</span></b></th>
                                <th style="border:1px solid #000; padding:4px; text-align:right;"><b>Qty <br/><span style="font-size:9px; font-weight:normal;">الكمية</span></b></th>
                                <th style="border:1px solid #000; padding:4px;"><b>Unit <br/><span style="font-size:9px; font-weight:normal;">الوحدة</span></b></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="delivered_lines" t-value="o.move_ids_without_package.filtered(lambda l: l.quantity > 0)"/>

                            <tr t-foreach="delivered_lines" t-as="line">
                                <td style="border:1px solid #000; padding:4px; text-align:center;">
                                    <b><span t-esc="line_index + 1"/></b>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <b><span t-field="line.product_id.default_code"/></b>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <!-- English Product Name (Line 1) -->
                                    <div style="text-align:left; direction:ltr;">
                                        <b><span t-esc="line.product_id.with_context(lang='en_GB').name"/></b>
                                    </div>
                                    <!-- Arabic Product Name (Line 2) -->
                                    <div style="text-align:right; direction:rtl; margin-top:2px;">
                                        <b><span t-esc="line.product_id.with_context(lang='ar_001').name"/></b>
                                    </div>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;">
                                    <b><span t-field="line.qty_meter"/></b>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;">
                                    <b><span t-field="line.quantity"/></b>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <b><span t-field="line.product_uom"/></b>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="3" style="border:1px solid #000; padding:4px; text-align:right; font-weight:bold;">
                                    Total / الإجمالي
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:right; font-weight:bold;">
                                    <span t-esc="sum(delivered_lines.mapped('qty_meter'))"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:right; font-weight:bold;">
                                    <span t-esc="sum(delivered_lines.mapped('quantity'))"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; font-weight:bold;">
                                    <t t-if="delivered_lines">
                                        <span t-esc="delivered_lines[-1].product_uom.name"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Notes Section: Reduced spacing and font size -->
                    <div style="margin-top:12px; font-size:13px;">
                        <strong>Notes / الملاحظات:</strong>
                        <hr style="margin:4px 0;"/>
                        <span t-field="o.note"/>
                    </div>

                    <!-- Signatures Section: Tightened spacing so it fits on Page 1 -->
                    <t t-if="not env.context.get('hide_signatures')">
                        <div style="margin-top:25px; width:100%; text-align:center; font-size:16px; page-break-inside:avoid;">

                            <div style="display:inline-block; width:32%; vertical-align:top;">
                                <strong>Warehouse Manager</strong><br/>
                                <span style="font-size:13px;">أمين المستودع</span>
                                <br/><br/><br/>
                                <div style="border-top:1px solid #000; width:120px; margin:0 auto;"></div>
                            </div>

                            <div style="display:inline-block; width:32%; vertical-align:top;">
                                <strong>Driver Signature</strong><br/>
                                <span style="font-size:13px;">توقيع السائق</span>
                                <br/><br/><br/>
                                <div style="border-top:1px solid #000; width:120px; margin:0 auto;"></div>
                            </div>

                            <div style="display:inline-block; width:32%; vertical-align:top;">
                                <strong>Customer Signature</strong><br/>
                                <span style="font-size:13px;">توقيع العميل</span>
                                <br/><br/><br/>
                                <div style="border-top:1px solid #000; width:120px; margin:0 auto;"></div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>