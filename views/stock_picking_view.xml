<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_tree_inherit_sort_origin" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.sort.origin</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">origin desc</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
            <field name="delivery_badge_status"
                   widget="badge"
                   decoration-success="delivery_badge_status == 'full'"
                   decoration-warning="delivery_badge_status == 'partial'"
                   decoration-info="delivery_badge_status == 'pending'"
                   decoration-danger="delivery_badge_status == 'cancelled'"
                   optional="show"/>
        </xpath>
        </field>
    </record>
    <record id="view_picking_form_inherit_delivery_info" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.info</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_set_to_draft"
                        string="Set to Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'cancel'"/>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="after">
                    <field name="driver_name" required="1"/>
                    <field name="driver_mobile" required="1"/>
                    <field name="city_code"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="column_invisible">False</attribute>
            </xpath>
            <xpath expr="//button[@name='action_assign']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                    <field name="truck_plate_no" required="1"/>
                    <field name="customer_phone"/>
                    <field name="leave_datetime"/>
            </xpath>
            <xpath expr="//field[@name='group_id']" position="after">
                <field name="is_force_delivered"
                       widget="boolean_toggle"
                       invisible="state != 'done'"/>
            </xpath>
            <!-- GRAB ODOO'S DEFAULT sale_id AND MOVE IT UNDER leave_datetime -->
            <xpath expr="//field[@name='leave_datetime']" position="after">
                <field name="sale_id" position="move"/>
            </xpath>
<!--            <xpath expr="//field[@name='sale_id']" position="attributes">-->
<!--                <attribute name="domain">[('state', '=', 'sale')]</attribute>-->
<!--            </xpath>-->
            <!-- Ensure it is editable in draft state and disable creating new SOs from here -->
            <xpath expr="//field[@name='sale_id']" position="attributes">
                <attribute name="readonly">state == 'done'</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="%(action_report_delivery_note_custom)d"
                    type="action"
                    string="Print Delivery Note"
                    invisible="state != 'done'"
                    class="btn-primary"/>
            </xpath>
            <!-- Hide print button when state = assigned (stable @name, no issue) -->
            <xpath expr="//header/button[@name='do_print_picking']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- hide Mark as done button -->
            <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide print button when state = done (use stable @type + @groups + @data-hotkey) -->
            <xpath expr="//header/button[@type='action' and @groups='base.group_user' and @data-hotkey='o']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Make the Demand column (Remaining Qty) strictly read-only -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="stock.action_unreserve_picking" model="ir.actions.server">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.action_toggle_is_locked" model="ir.actions.server">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.action_scrap" model="ir.actions.server">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.stock_split_picking" model="ir.actions.server">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.menu_wms_barcode_nomenclature_all" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="delievry_default_filter_remove" model="ir.ui.view">
        <field name="name">delivery.order.search.remove.my.quotation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='delivery']" position="replace"/>
        </field>
    </record>
    <record id="stock.stock_picking_type_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="mrp.mrp_operation_picking" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_stock_adjustments" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_product_stock" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_valuation" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock_account.menu_valuation" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_warehouse_config" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
