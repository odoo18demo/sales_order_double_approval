<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_mrp_production_form_inherit_no_warning" model="ir.ui.view">
            <field name="name">mrp.production.form.no.warning</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//header/button[@name='button_mark_done' and @invisible='move_raw_ids or not show_produce']" position="attributes">
                    <attribute name="confirm"></attribute>
                </xpath>

                <xpath expr="//header/button[@name='button_mark_done' and @invisible='move_raw_ids or not show_produce_all']" position="attributes">
                    <attribute name="confirm"></attribute>
                </xpath>

            </field>
        </record>
        <record id="mrp_account.action_wip_accounting" model="ir.actions.act_window">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="mrp.action_mrp_production_split" model="ir.actions.act_window">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="mrp.action_mrp_production_split_multi" model="ir.actions.act_window">
            <field name="binding_model_id" eval="False"/>
        </record>

        <record id="mrp.action_production_order_lock_unlock" model="ir.actions.server">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="mrp.action_production_order_scrap" model="ir.actions.server">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="mrp.action_plan_with_components_availability" model="ir.actions.server">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="mrp.menu_mrp_scrap" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="mrp.mrp_planning_menu_root" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="mrp.menu_mrp_configuration" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="mrp.menu_mrp_unbuild" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="view_mrp_production_form_inherit_hide_unbuild" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.hide.unbuild</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//button[@name='button_unbuild']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

            </field>
        </record>
        <record id="manufacture_default_filter_remove" model="ir.ui.view">
            <field name="name">manufacture.search.remove.my.quotation</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='todo']" position="replace"/>
            </field>
        </record>
    </data>
</odoo>