<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_delivery_slip_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"> </t>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family: 'DejaVu Sans', Arial, sans-serif; margin-top: 0px;">
                <!-- Increased font sizes and reduced margin-bottom -->
                <h2 style="text-align:center; font-size:24px; margin-top: 0px; margin-bottom: 10px;">
                    Delivery Note <br/>
                    <span style="font-size: 20px; font-weight: normal;">مذكرة تسليم</span>
                </h2>

                <!-- Reduced margin-bottom to pull the table up -->
                <div class="row" style="margin-bottom: 10px;">
                    <div class="col-6">
                        <!-- Reduced padding from 5px to 2px for tighter line spacing -->
                        <div style="padding: 2px;"><b>SN / الرقم التسلسلي:</b> <span t-field="o.name" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                        <div style="padding: 2px;"><b>City Code / رمز المدينة:</b> <span t-field="o.city_code" dir="ltr"/></div>
                        <div style="padding: 2px;"><b>Customer / العميل:</b> <span t-field="o.partner_id.display_name"/></div>
                        <div style="padding: 2px;">
                            <b>Address / العنوان:</b>
                            <span t-esc="', '.join(filter(None, [o.partner_id.street, o.partner_id.street2, o.partner_id.city, o.partner_id.state_id.name if o.partner_id.state_id else '', o.partner_id.zip, o.partner_id.country_id.name if o.partner_id.country_id else '']))"/>
                        </div>
                        <div style="padding: 2px;"><b>Sales Order / أمر المبيعات:</b> <span t-field="o.origin" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                        <div style="padding: 2px;"><b>Driver Name / اسم السائق:</b> <span t-field="o.driver_name"/></div>
                    </div>
                    <div class="col-6">
                        <!-- Reduced padding from 5px to 2px -->
                        <div style="padding: 2px;"><b>Date / التاريخ:</b> <span t-field="o.scheduled_date" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                        <div style="padding: 2px;"><b>Salesman / مندوب المبيعات:</b><span t-if="o.sale_id" t-field="o.sale_id.user_id.name"/><span t-else="" t-field="o.sales_person_id.name"/></div>
                        <div style="padding: 2px;"><b>Customer Phone / هاتف العميل:</b> <span t-field="o.customer_phone" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                        <div style="padding: 2px;"><b>Leave Time / وقت المغادرة:</b> <span t-field="o.leave_datetime" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                        <div style="padding: 2px;"><b>Truck Plate No / رقم اللوحة:</b> <span t-field="o.truck_plate_no" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                        <div style="padding: 2px;"><b>Driver Mobile / جوال السائق:</b> <span t-field="o.driver_mobile" dir="ltr" style="display: inline-block; direction: ltr; unicode-bidi: embed;"/></div>
                    </div>
                </div>

                <!-- Added margin-top: 10px (was 20px) -->
                <table style="width:100%; border-collapse: collapse; margin-top: 10px;">
                    <thead>
                        <tr style="border-bottom: 1px solid black;">
                            <!-- New Columns Added Here -->
                            <th style="padding: 8px; text-align:center;">
                                <strong>#</strong>
                            </th>
                            <th style="padding: 8px;">
                                <strong>Item Code</strong><br/>
                                <span style="font-size: 10px; font-weight: normal;">رمز الصنف</span>
                            </th>
                            <!-- Original Columns -->
                            <th style="padding: 8px;">
                                <strong>Product</strong><br/>
                                <span style="font-size: 10px; font-weight: normal;">المنتج</span>
                            </th>
                            <th style="padding: 8px;" class="text-end">
                                <strong>Qty (MTR)</strong><br/>
                                <span style="font-size: 10px; font-weight: normal;">الكمية (متر)</span>
                            </th>
                            <th style="padding: 8px;" class="text-end">
                                <strong>Qty</strong><br/>
                                <span style="font-size: 10px; font-weight: normal;">الكمية</span>
                            </th>
                            <th style="padding: 8px;" class="text-end">
                                <strong>Unit</strong><br/>
                                <span style="font-size: 10px; font-weight: normal;">الوحدة</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.quantity > 0)"/>
                        <tr t-foreach="lines" t-as="move" style="border-bottom: 1px solid #eee;">
                            <!-- New Data Cells Added Here -->
                            <td style="padding: 8px; text-align:center;">
                                <span t-esc="move_index + 1"/>
                            </td>
                            <td style="padding: 8px;">
                                <span t-field="move.product_id.default_code"/>
                            </td>
                            <!-- Original Data Cells -->
                            <td style="padding: 8px;">
                                <span t-esc="move.product_id.name.replace('Â', '').replace('\xa0', ' ')"/>
                            </td>
                            <td style="padding: 8px;" class="text-end"><span t-field="move.qty_meter"/></td>
                            <td style="padding: 8px;" class="text-end"><span t-field="move.quantity"/></td>
                            <td style="padding: 8px;" class="text-end"><span t-field="move.product_uom"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>