<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="finance_team_list_view" model="ir.ui.view">
        <field name="name">finance.team.list.view</field>
        <field name="model">financial.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="finance_team_form_view" model="ir.ui.view">
        <field name="name">finance.team.form.view</field>
        <field name="model">financial.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Members" name="members_users">
                            <field name="member_ids" mode="kanban" class="w-100">
                                <kanban>
                                    <templates>
                                        <t t-name="card" class="flex-row">
                                            <aside>
                                                <field name="avatar_128" widget="image" class="o_image_64_cover" alt="Avatar"/>
                                            </aside>
                                            <main class="ms-3">
                                                <field name="name" class="fw-bold fs-5"/>
                                                <div class="d-flex align-items-baseline text-break">
                                                    <i class="fa fa-envelope me-1" role="img" aria-label="Email" title="Email"/>
                                                    <field name="email"/>
                                                </div>
                                            </main>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_finance_team" model="ir.actions.act_window">
        <field name="name">Finance Team</field>
        <field name="res_model">financial.team</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_financial_team_root"
        name="Financial Teams"
        parent="sale.menu_sale_config"
        action="action_finance_team"
    />
</odoo>