<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="paperformat_custom_delivery_note" model="report.paperformat">
        <field name="name">Custom Delivery Note Paperformat</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30.00</field>
        <field name="margin_bottom">20.00</field>
        <field name="margin_left">7.00</field>
        <field name="margin_right">7.00</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field> <field name="dpi">90</field>
    </record>
    <record id="action_report_delivery_note_custom" model="ir.actions.report">
        <field name="name">Delivery Note</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_order_double_approval.delivery_note_template</field>
        <field name="report_file">sales_order_double_approval.delivery_note_template</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
